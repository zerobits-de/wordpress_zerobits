# Copy to .env and adjust. Never commit .env.

# WordPress is exposed on http://localhost:${WORDPRESS_PORT}
WORDPRESS_PORT=8093

# Database (internal to the Docker network; not exposed to the host)
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# Used by `make install` (WP-CLI). WORDPRESS_LOCALE is the language of wp-admin only;
# the website's languages are configured in theme/content/site.json.
WORDPRESS_SITE_TITLE="Zerobits"
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=admin
WORDPRESS_ADMIN_EMAIL=admin@example.com
WORDPRESS_LOCALE=de_DE
