{#
  Two-colour heading: the lead in ink, the accent in the brand colour.
  Params: title ({lead, accent}), tag (default h2), class (optional), id (optional)
#}
{% set tag = tag|default('h2') %}
<{{ tag }} class="dual-title {{ class|default('') }}"{% if id|default('') %} id="{{ id|e('html_attr') }}"{% endif %}>
  <span class="dual-title__lead">{{ title.lead|e }}</span>
  <span class="dual-title__accent">{{ title.accent|e }}</span>
</{{ tag }}>
